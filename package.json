{
  "name": "pix-tips",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "tsx server.ts",
    "start:prod": "NODE_ENV=production tsx server.ts",
    "migrate": "prisma migrate deploy",
    "lint": "eslint",
    "db:seed": "tsx src/lib/seed.ts",
    "db:push": "prisma db push",
    "sounds:generate": "tsx src/scripts/generate-sound-placeholders.ts",
    "sounds:npc": "tsx src/scripts/generate-ncs-sounds.ts",
    "sounds:ncs": "tsx src/scripts/generate-ncs-sounds.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "postinstall": "prisma generate && node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "otplib": "^13.4.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tmi.js": "^1.8.5",
    "tsx": "^4.22.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tmi.js": "^1.8.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
