# =============================================================================
#  pix.tips — Variáveis de ambiente de PRODUÇÃO
#  Copie para .env.production e preencha todos os valores marcados com REQUIRED
#  NUNCA commit o .env.production no git
# =============================================================================

# ── Aplicação ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://pix.tips
NEXT_PUBLIC_SOCKET_URL=https://pix.tips
# URL canônica do site usada em links de e-mail, OG, etc.
NEXT_PUBLIC_SITE_URL=https://pix.tips

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Usado pelo docker-compose; POSTGRES_PASSWORD deve ser uma senha forte e única
POSTGRES_PASSWORD=REQUIRED_senha_forte_aqui

# DATABASE_URL é montado automaticamente pelo docker-compose a partir de POSTGRES_PASSWORD
# Não precisa preencher aqui — o compose injeta:
# DATABASE_URL=postgresql://tippage:${POSTGRES_PASSWORD}@postgres:5432/tippage

# ── Autenticação ───────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatórios — gere com: openssl rand -base64 48
AUTH_SECRET=REQUIRED_minimo_32_caracteres_aqui

# ── OAuth Providers ───────────────────────────────────────────────────────────
# Base URL para callbacks OAuth (sem trailing slash)
OAUTH_REDIRECT_BASE=https://pix.tips

# Twitch OAuth (login de criadores)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Callback: https://pix.tips/api/auth/oauth/twitch/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: https://pix.tips/api/auth/oauth/google/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Callback: https://pix.tips/api/auth/oauth/discord/callback

# ── Twitch ChatBot ─────────────────────────────────────────────────────────────
# Conta de bot separada para enviar mensagens no chat Twitch
TWITCH_BOT_USERNAME=
# Token OAuth do bot — gere em https://twitchapps.com/tmi/
TWITCH_BOT_OAUTH_TOKEN=

# ── E-mail (transacional) ──────────────────────────────────────────────────────
EMAIL_FROM=noreply@pix.tips
RESEND_API_KEY=REQUIRED

# ── Woovi (pagamentos Pix) ─────────────────────────────────────────────────────
# Obrigatório para receber doações e processar saques em produção.
# Sem WOOVI_APP_ID, o sistema retorna "Recebimentos Pix indisponíveis".
#
# Onde obter:
#   WOOVI_APP_ID        → Painel Woovi → API → App ID (usado como Authorization)
#   WOOVI_WEBHOOK_SECRET → Painel Woovi → Webhooks → Secret
#
# Configure o webhook no painel Woovi:
#   URL: https://pix.tips/api/webhooks/woovi
#   Eventos: OPENPIX:CHARGE_COMPLETED, OPENPIX:CHARGE_COMPLETED_NOT_SAME_CUSTOMER_PAYER
WOOVI_APP_ID=REQUIRED
WOOVI_WEBHOOK_SECRET=REQUIRED

# Taxa de processamento Pix cobrada ao doador (%)
# WOOVI_FEE_PERCENT=0.8
# Valor mínimo da taxa em reais
# WOOVI_FEE_MIN=0.5
# Valor máximo da taxa em reais
# WOOVI_FEE_MAX=5
# Taxa fixa de saque cobrada ao criador (padrão: R$ 2,50)
# WOOVI_PAYOUT_FEE=2.50
# Taxa interna Woovi por saque (padrão: R$ 1,00)
# WOOVI_WITHDRAW_FEE=1

# ── Didit (KYC / verificação de identidade) ───────────────────────────────────
DIDIT_API_KEY=REQUIRED
DIDIT_WEBHOOK_SECRET=REQUIRED
# ID do workflow de verificação no painel Didit (usa valor padrão se omitido)
# DIDIT_WORKFLOW_ID=0d591c51-d990-4aa2-a26f-cb455bc0342b
# URL do webhook a configurar no painel Didit:
# https://pix.tips/api/webhooks/didit

# ── ElevenLabs (síntese de voz TTS) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
# ID do modelo TTS (usa padrão se omitido)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Storage de arquivos (S3 / Cloudflare R2) ──────────────────────────────────
# Dois buckets recomendados no Cloudflare R2:
#
# 1) Bucket PÚBLICO (mídia) — avatars, alertas, sons, fundos
#    → Conecte o domínio cdn.pix.tips neste bucket (Custom Domain no R2)
AWS_S3_BUCKET=pix-tips-media
AWS_CDN_URL=https://cdn.pix.tips

# 2) Bucket PRIVADO (KYC) — RG, CNH, selfie
#    → NÃO conecte domínio público; acesso só via API admin (URL pré-assinada)
AWS_S3_KYC_BUCKET=pix-tips-kyc

# Credenciais R2 (mesmo token pode ter acesso aos dois buckets)
AWS_REGION=auto
AWS_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=REQUIRED
AWS_SECRET_ACCESS_KEY=REQUIRED

# ── Segurança adicional ────────────────────────────────────────────────────────
# NÃO definir em produção (bypassa verificação de webhook):
# WOOVI_WEBHOOK_SKIP_VERIFY=1
# DIDIT_WEBHOOK_SKIP_VERIFY=1

# ── Verificação de CPF ─────────────────────────────────────────────────────────
# Provedor de consulta de CPF: none | mock | serpro-demo | serpro | cpfcnpj | workbuscas
KYC_CPF_PROVIDER=serpro

# Serpro Datavalid (produção)
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# SERPRO_DATAVALID_URL=https://gateway.apiserpro.serpro.gov.br/datavalid/v4/pf-basica

# CPF.CNPJ.com.br
# CPF_CNPJ_API_TOKEN=
# CPF_CNPJ_PACKAGE_ID=

# Workbuscas
# WORKBUSCAS_TOKEN=
# WORKBUSCAS_API_URL=https://completa.workbuscas.com/api

# ── Funcionalidades opcionais ──────────────────────────────────────────────────
# Comissão da plataforma (padrão: 0.02 = 2%)
# COMMISSION_RATE=0.02

# Valor mínimo de saque em reais (padrão: 20)
# MIN_WITHDRAW_AMOUNT=20
